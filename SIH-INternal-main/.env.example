# Server and runtime
PORT=3000
NODE_ENV=development

# Database: PostgreSQL connection URL (Neon)
DATABASE_URL=postgresql://postgres:password@localhost:5432/innoprocure

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGINS=http://localhost:3000
DEMO_PASSWORD=
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_BACKOFF_THRESHOLD=5
AUTH_RATE_LIMIT_BASE_DELAY_MS=1000
AUTH_RATE_LIMIT_MAX_BACKOFF_MS=900000
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX_REQUESTS=60
AUTHENTICATED_RATE_LIMIT_WINDOW_MS=60000
AUTHENTICATED_RATE_LIMIT_MAX_REQUESTS=300
TRUST_PROXY=false

# Google Gemini API key (kept strictly server-side)
GEMINI_API_KEY=

# Neo4j AuraDB (server-side only; never expose these in frontend code)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Storage Provider
STORAGE_PROVIDER=local
UPLOAD_DIR=./backend/uploads

